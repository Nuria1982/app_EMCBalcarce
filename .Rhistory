) +
annotate(
"text",
x = 1.2,
y = 2.65,
label = "El Niño",
color = "#991b1b",
fontface = "bold",
size = 5,
hjust = 0
) +
annotate(
"text",
x = 1.2,
y = 0.18,
label = "Neutral",
color = "#475569",
fontface = "bold",
size = 4.5,
hjust = 0
) +
annotate(
"text",
x = 1.2,
y = -1.65,
label = "La Niña",
color = "#1d4ed8",
fontface = "bold",
size = 5,
hjust = 0
) +
annotate(
"text",
x = 7.1,
y = -1.85,
label = "Inicio criterio: JJA",
color = "#0f172a",
fontface = "bold",
size = 3.8,
hjust = 0
) +
scale_x_continuous(
breaks = 1:12,
labels = orden_trimestres,
expand = expansion(mult = c(0.01, 0.02))
) +
scale_y_continuous(
limits = c(-2, 3),
breaks = seq(-2, 3, 0.5)
) +
labs(
title = "Años seleccionados con presencia de El Niño sostenida",
subtitle = "Evolución trimestral del Oceanic Niño Index (ONI). Línea negra: promedio de los años seleccionados.",
x = NULL,
y = "Anomalía ONI (°C)",
color = "Año"
) +
theme_minimal(base_size = 13) +
theme(
plot.title = element_text(
face = "bold",
size = 20,
color = "#0b3d5c"
),
plot.subtitle = element_text(
size = 12,
color = "#475569"
),
axis.title.y = element_text(
face = "bold",
color = "#0f172a"
),
axis.text.x = element_text(
color = "#0f172a",
size = 11
),
axis.text.y = element_text(
color = "#0f172a"
),
legend.position = "right",
legend.title = element_text(
face = "bold",
color = "#0b3d5c"
),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(
color = "#e2e8f0",
linewidth = 0.35
),
plot.background = element_rect(
fill = "white",
color = NA
),
panel.background = element_rect(
fill = "white",
color = NA
)
)
